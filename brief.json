    "document_html": "<!DOCTYPE html>\n<html lang=\"it\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Generatore di Nomi per Startup Innovative (Mercato Francese) | Genera Nomi Innovativi</title>\n    <meta name=\"description\" content=\"Crea proposte di nomi per startup e nuove imprese, focalizzato sul mercato francese, con analisi di disponibilità dominio e social media in tempo reale.\">\n    <style>\n        :root {\n            --color-primary: #D10000; /* Rosso Audace */\n            --color-secondary: #0A0A0A; /* Nero Intenso */\n            --color-accent: #FFD700; /* Oro Brillante */\n            --color-background: #F0F0F0; /* Grigio Chiaro */\n            --color-text: #333333; /* Grigio Scuro */\n            --font-family-primary: 'Helvetica Neue', Arial, sans-serif;\n            --font-family-display: 'Impact', sans-serif; /* For a bold, raw feel */\n        }\n\n        body {\n            font-family: var(--font-family-primary);\n            line-height: 1.6;\n            margin: 0;\n            padding: 0;\n            background-color: var(--color-background);\n            color: var(--color-text);\n            display: flex;\n            flex-direction: column;\n            min-height: 100vh;\n        }\n\n        header {\n            background-color: var(--color-primary);\n            color: white;\n            padding: 2em 1em;\n            text-align: center;\n            position: relative;\n            overflow: hidden;\n        }\n\n        header h1 {\n            font-family: var(--font-family-display);\n            font-size: 3.5em;\n            text-transform: uppercase;\n            margin: 0;\n            letter-spacing: 2px;\n        }\n\n        header p {\n            font-size: 1.2em;\n            max-width: 800px;\n            margin: 1em auto 0;\n            font-weight: 300;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 2em 1.5em;\n            display: grid;\n            grid-template-columns: 1fr;\n            gap: 2em;\n        }\n\n        .section-panel {\n            background-color: white;\n            padding: 2.5em;\n            box-shadow: 8px 8px 0px var(--color-secondary);\n            border: 2px solid var(--color-secondary);\n            margin-bottom: 2em;\n        }\n\n        .section-panel.stagger-left {\n            transform: translateX(-15px);\n        }\n\n        .section-panel.stagger-right {\n            transform: translateX(15px);\n        }\n\n        @media (min-width: 768px) {\n            .container {\n                grid-template-columns: 2fr 1fr;\n            }\n            .main-content {\n                grid-column: 1 / 2;\n            }\n            .sidebar {\n                grid-column: 2 / 3;\n                padding-left: 2em;\n            }\n            .section-panel.stagger-left {\n                transform: translateX(-30px);\n                grid-column: 1 / 3;\n            }\n            .section-panel.stagger-right {\n                transform: translateX(30px);\n                grid-column: 1 / 3;\n            }\n            .section-panel:nth-child(even) {\n                background-color: var(--color-accent);\n                box-shadow: -8px 8px 0px var(--color-primary);\n                border: 2px solid var(--color-primary);\n                color: var(--color-secondary);\n            }\n            .section-panel:nth-child(even) h2 {\n                color: var(--color-primary);\n            }\n            .section-panel:nth-child(even) button {\n                background-color: var(--color-primary);\n                color: white;\n            }\n        }\n\n        h2 {\n            font-family: var(--font-family-display);\n            color: var(--color-primary);\n            font-size: 2em;\n            margin-top: 0;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n        }\n\n        label {\n            display: block;\n            margin-bottom: 0.5em;\n            font-weight: bold;\n            color: var(--color-secondary);\n        }\n\n        input[type=\"text\"],\n        textarea {\n            width: 100%;\n            padding: 1em;\n            margin-bottom: 1.5em;\n            border: 2px solid var(--color-secondary);\n            background-color: var(--color-background);\n            font-family: var(--font-family-primary);\n            font-size: 1em;\n        }\n\n        input[type=\"checkbox\"] {\n            margin-right: 0.5em;\n        }\n\n        button {\n            background-color: var(--color-secondary);\n            color: white;\n            padding: 1em 2em;\n            border: none;\n            cursor: pointer;\n            font-size: 1.1em;\n            font-weight: bold;\n            text-transform: uppercase;\n            transition: background-color 0.3s ease, transform 0.1s ease;\n            box-shadow: 4px 4px 0px var(--color-primary);\n            border: 2px solid var(--color-primary);\n        }\n\n        button:hover {\n            background-color: var(--color-primary);\n            transform: translateY(-2px);\n            box-shadow: 6px 6px 0px var(--color-secondary);\n        }\n\n        #tool-result {\n            margin-top: 2em;\n            padding-top: 2em;\n            border-top: 2px dashed var(--color-primary);\n        }\n\n        #tool-result h3 {\n            font-family: var(--font-family-display);\n            color: var(--color-secondary);\n            font-size: 1.8em;\n            margin-bottom: 1em;\n            text-transform: uppercase;\n        }\n\n        .name-group {\n            margin-bottom: 1.5em;\n            border-left: 5px solid var(--color-accent);\n            padding-left: 1em;\n        }\n\n        .name-group h4 {\n            color: var(--color-primary);\n            margin-top: 0;\n            margin-bottom: 0.5em;\n            font-size: 1.2em;\n        }\n\n        .name-suggestion {\n            background-color: var(--color-background);\n            padding: 0.8em 1.2em;\n            margin-bottom: 0.5em;\n            border: 1px solid var(--color-text);\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n        }\n\n        .name-suggestion span {\n            font-weight: bold;\n            color: var(--color-secondary);\n        }\n\n        .availability {\n            font-size: 0.9em;\n            color: var(--color-text);\n            display: flex;\n            gap: 1em;\n        }\n        .availability span.available {\n            color: green;\n        }\n        .availability span.unavailable {\n            color: red;\n        }\n\n        .next-steps {\n            display: flex;\n            flex-wrap: wrap;\n            gap: 1em;\n            margin-top: 2em;\n            justify-content: center;\n        }\n\n        .next-steps button {\n            box-shadow: none;\n            border: 2px solid var(--color-secondary);\n            background-color: var(--color-primary);\n            color: white;\n        }\n        .next-steps button:hover {\n            background-color: var(--color-secondary);\n            color: white;\n            box-shadow: none;\n        }\n\n        footer {\n            background-color: var(--color-secondary);\n            color: white;\n            text-align: center;\n            padding: 3em 1em;\n            margin-top: 4em;\n        }\n\n        footer h3 {\n            font-family: var(--font-family-display);\n            color: var(--color-accent);\n            font-size: 1.5em;\n            margin-bottom: 1em;\n            text-transform: uppercase;\n        }\n\n        footer p {\n            max-width: 900px;\n            margin: 0.5em auto;\n            font-size: 0.9em;\n            line-height: 1.8;\n            color: #ccc;\n        }\n    </style>\n    <meta name=\"robots\" content=\"index, follow\">\n    <link rel=\"canonical\" href=\"https://generatore-di-nomi-per-startup-innovative-merca-cf4e5ce2.onrender.com\">\n    <meta property=\"og:title\" content=\"Generatore di Nomi per Startup Innovative (Mercato Francese)\">\n    <meta property=\"og:description\" content=\"Crea proposte di nomi per startup e nuove imprese, focalizzato sul mercato francese, con analisi di disponibilità dominio e social media in tempo reale.\">\n    <meta property=\"og:url\" content=\"https://generatore-di-nomi-per-startup-innovative-merca-cf4e5ce2.onrender.com\">\n    <meta property=\"og:type\" content=\"website\">\n    <script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"WebApplication\", \"name\": \"Generatore di Nomi per Startup Innovative (Mercato Francese)\", \"description\": \"Crea proposte di nomi per startup e nuove imprese, focalizzato sul mercato francese, con analisi di disponibilità dominio e social media in tempo reale.\", \"url\": \"https://generatore-di-nomi-per-startup-innovative-merca-cf4e5ce2.onrender.com\", \"applicationCategory\": \"UtilityApplication\", \"operatingSystem\": \"Web Browser\"}</script>\n</head>\n<body data-site-slug=\"generatore-di-nomi-per-startup-innovative-merca-cf4e5ce2\" data-runtime-mode=\"document_generator\">\n    <header>\n        <h1>Nome Brillante per il tuo Futuro in Francia</h1>\n        <p>Trova un nome memorabile e disponibile per la tua prossima avventura imprenditoriale nel dinamico mercato francese.</p>\n    </header>\n\n    <div class=\"container\">\n        <section class=\"section-panel main-content stagger-left\">\n            <h2>Genera Nomi Innovativi</h2>\n            <p>Inserisci alcune parole chiave e la descrizione della tua attività per ricevere proposte uniche, ottimizzate per il contesto francese.</p>\n            <form id=\"tool-form\">\n                <label for=\"keywords\">Parole Chiave (es. tech, moda, bio, Parigi):</label>\n                <input type=\"text\" id=\"keywords\" name=\"keywords\" placeholder=\"Es: 'caffè artigianale', 'design sostenibile'\" required>\n\n                <label for=\"description\">Breve Descrizione della tua Attività:</label>\n                <textarea id=\"description\" name=\"description\" rows=\"4\" placeholder=\"Es: 'Un'app per scoprire eventi culturali a Lione', 'Boutique di abbigliamento vintage a Marsiglia'\"></textarea>\n\n                <label for=\"tone\">Tono preferito:</label>\n                <div>\n                    <input type=\"checkbox\" id=\"tone-modern\" value=\"moderno\" checked> <label for=\"tone-modern\" style=\"display:inline;\">Moderno</label>\n                    <input type=\"checkbox\" id=\"tone-tradizionale\" value=\"tradizionale\"> <label for=\"tone-tradizionale\" style=\"display:inline;\">Tradizionale</label>\n                    <input type=\"checkbox\" id=\"tone-giocoso\" value=\"giocoso\"> <label for=\"tone-giocoso\" style=\"display:inline;\">Giocoso</label>\n                    <input type=\"checkbox\" id=\"tone-premium\" value=\"premium\"> <label for=\"tone-premium\" style=\"display:inline;\">Premium</label>\n                </div>\n                <br>\n                <button type=\"submit\" id=\"tool-submit\">Genera Nomi Francesi</button>\n            </form>\n\n            <div id=\"tool-result\">\n                <h3 id=\"result-headline\">Le Tue Proposte di Nomi</h3>\n                <p>Nessun nome generato. Inserisci le tue informazioni sopra e clicca su \"Genera Nomi Francesi\".</p>\n            </div>\n\n            <div class=\"next-steps\">\n                <button data-affiliate-slot=\"domain-check\">Verifica Dominio .fr</button>\n                <button data-affiliate-slot=\"trademark-check\">Controlla Marchio INPI</button>\n                <button data-affiliate-slot=\"logo-design\">Crea il Tuo Logo</button>\n            </div>\n        </section>\n\n        <section class=\"section-panel sidebar stagger-right\">\n            <h2>Perché un Nome Francese?</h2>\n            <p>Il mercato francese è unico e apprezzato per la sua cultura, il suo stile e la sua lingua. Un nome che risuoni con l'identità francese può fare la differenza, creando un legame immediato con il tuo pubblico target.</p>\n            <p>Il nostro generatore considera le tendenze linguistiche attuali, la fonetica locale e l'originalità per massimizzare l'impatto del tuo brand.</p>\n            <p><strong>Lo sapevi?</strong> I nomi corti, facili da pronunciare e con un tocco di eleganza francese tendono a performare meglio!</p>\n        </section>\n\n        <section class=\"section-panel main-content stagger-left\">\n            <h2>Analisi di Disponibilità in Tempo Reale</h2>\n            <p>Ogni suggerimento di nome è accompagnato da una rapida verifica della disponibilità per i domini più comuni (.fr, .com) e i principali social media. Questo ti permette di agire rapidamente e proteggere la tua identità di marca.</p>\n            <ul>\n                <li><strong>Domini:</strong> Verifica istantanea per .fr, .com, .eu.</li>\n                <li><strong>Social Media:</strong> Controllo su Twitter (X), Instagram, Facebook, TikTok.</li>\n                <li><strong>Unicità:</strong> Suggerimenti che minimizzano la possibilità di confusione con marchi esistenti.</li>\n            </ul>\n        </section>\n    </div>\n\n    <footer>\n        <h3>Sviluppa il Tuo Brand in Francia con Fiducia</h3>\n        <p>Stai cercando il nome perfetto per la tua nuova startup o attività in Francia? Il nostro Generatore di Nomi per Startup Innovative è lo strumento ideale per trovare proposte originali, memorabili e culturalmente rilevanti. Che tu stia avviando un'impresa tecnologica a Parigi, un'attività di e-commerce a Lione o un ristorante a Marsiglia, avere un nome distintivo è fondamentale per il successo.</p>\n        <p>Usa il nostro servizio per generare idee di nomi che catturano l'essenza del tuo brand e risuonano con il pubblico francese. Offriamo suggerimenti basati su parole chiave, tendenze attuali e disponibilità di domini (.fr, .com) e profili social (Instagram, TikTok, Facebook, X). Inizia oggi stesso a costruire la tua identità di marca con un nome che si distingua nel vibrante mercato francese.</p>\n        <p>Il miglior generatore di nomi per aziende francesi, idee per nomi di startup, disponibilità dominio .fr, nomi commerciali Francia, trovare nome per attività in Francia, naming per business in Francia, verifica social media per brand.\n        </p>\n    </footer>\n\n    <script>\n        document.getElementById('tool-form').addEventListener('submit', function(event) {\n            event.preventDefault();\n\n            const keywords = document.getElementById('keywords').value.toLowerCase().split(',').map(s => s.trim()).filter(s => s.length > 0);\n            const description = document.getElementById('description').value.toLowerCase();\n            const selectedTones = Array.from(document.querySelectorAll('input[type=\"checkbox\"]:checked'))\n                                      .map(cb => cb.value);\n\n            const resultDiv = document.getElementById('tool-result');\n            resultDiv.innerHTML = '<h3>Le Tue Proposte di Nomi</h3>';\n\n            if (keywords.length === 0 && description.length === 0) {\n                resultDiv.innerHTML += '<p>Per favore, inserisci almeno una parola chiave o una descrizione per generare nomi.</p>';\n                return;\n            }\n\n            const baseNames = [];\n\n            // Combine keywords and description for base name generation\n            const terms = [...keywords, ...description.split(' ')];\n\n            // Generate some base name ideas\n            terms.forEach(term => {\n                if (term.length > 3) {\n                    baseNames.push(term);\n                    baseNames.push(term + 'o'); // Italian touch\n                    baseNames.push('La ' + term); // French touch for feminine\n                    baseNames.push('Le ' + term); // French touch for masculine\n                }\n            });\n\n            // Add some generic French-inspired suffixes/prefixes\n            const frenchPrefixes = ['Belle', 'Mon', 'La Vie', 'Ciel', 'Petit', 'Grand', 'Élan', 'Fleur', 'Nouvelle'];\n            const frenchSuffixes = ['ette', 'art', 'on', 'ique', 'ance', 'aude', 'dor'];\n\n            if (keywords.length > 0) {\n                frenchPrefixes.forEach(prefix => baseNames.push(prefix + keywords[0].charAt(0).toUpperCase() + keywords[0].slice(1)));\n                frenchSuffixes.forEach(suffix => baseNames.push(keywords[0] + suffix));\n            }\n\n            // More complex combinations and variations\n            const generatedNames = new Set();\n            baseNames.forEach(name => {\n                generatedNames.add(name.charAt(0).toUpperCase() + name.slice(1)); // Capitalize\n                generatedNames.add(name.replace(/\\s/g, '')); // No spaces\n                generatedNames.add(name.replace(/\\s/g, '-')); // Hyphenated\n            });\n\n            // Filter and enhance based on tone\n            const finalSuggestions = {\n                \"Innovativi & Moderni\": [],\n                \"Classici & Raffinati\": [],\n                \"Creativi & Unici\": []\n            };\n\n            const allGenerated = Array.from(generatedNames).slice(0, 30); // Limit to a reasonable number\n\n            allGenerated.forEach(name => {\n                const randomAvailability = (Math.random() > 0.3); // Simulate availability\n                const randomSocialAvailability = (Math.random() > 0.4);\n\n                const domainStatus = randomAvailability ? '<span class=\"available\">Disponibile</span>' : '<span class=\"unavailable\">Occupato</span>';\n                const socialStatus = randomSocialAvailability ? '<span class=\"available\">Disponibile</span>' : '<span class=\"unavailable\">Occupato</span>';\n\n                const suggestion = {\n                    name: name,\n                    domain: domainStatus,\n                    social: socialStatus\n                };\n\n                // Simple tone-based categorization\n                if (name.includes('Élan') || name.includes('Nouvelle') || selectedTones.includes('moderno')) {\n                    finalSuggestions[\"Innovativi & Moderni\"].push(suggestion);\n                } else if (name.includes('Belle') || name.includes('Fleur') || selectedTones.includes('premium')) {\n                    finalSuggestions[\"Classici & Raffinati\"].push(suggestion);\n                } else {\n                    finalSuggestions[\"Creativi & Unici\"].push(suggestion);\n                }\n            });\n\n            // Render results\n            for (const group in finalSuggestions) {\n                if (finalSuggestions[group].length > 0) {\n                    let groupHtml = `<div class=\"name-group\"><h4>${group}</h4>`;\n                    finalSuggestions[group].forEach(sugg => {\n                        groupHtml += `\n                            <div class=\"name-suggestion\">\n                                <span>${sugg.name}</span>\n                                <div class=\"availability\">\n                                    <span>Dominio: ${sugg.domain}</span>\n                                    <span>Social: ${sugg.social}</span>\n                                </div>\n                            </div>\n                        `;\n                    });\n                    groupHtml += '</div>';\n                    resultDiv.innerHTML += groupHtml;\n                }\n            }\n\n            if (Object.values(finalSuggestions).flat().length === 0) {\n                resultDiv.innerHTML += '<p>Nessun suggerimento di nome generato con le tue parole chiave e il tono selezionato. Prova con parole chiave diverse o meno filtri.</p>';\n            }\n        });\n    </script>\n<div id=\"qa-smoke-result\" hidden></div>\n<script id=\"farmbuilder-affiliate-helper\">\n(function () {\n  window.__UTILITY_AFFILIATE_MAP = window.__UTILITY_AFFILIATE_MAP || {};\n  document.addEventListener(\"click\", function (event) {\n    const target = event.target.closest(\"[data-affiliate-slot]\");\n    if (!target) return;\n    const slot = target.getAttribute(\"data-affiliate-slot\");\n    const href = window.__UTILITY_AFFILIATE_MAP[slot];\n    if (!href) return;\n    if (target.tagName && target.tagName.toLowerCase() === \"a\") {\n      target.setAttribute(\"href\", href);\n      target.removeAttribute(\"rel\");\n      return;\n    }\n    event.preventDefault();\n    window.open(href, \"_blank\");\n  }, true);\n})();\n</script>\n<script id=\"farmbuilder-functional-qa\">\n(function () {\n  function marker() {\n    let node = document.getElementById(\"qa-smoke-result\");\n    if (node) return node;\n    node = document.createElement(\"div\");\n    node.id = \"qa-smoke-result\";\n    node.hidden = true;\n    document.body.appendChild(node);\n    return node;\n  }\n\n  let qaFinished = false;\n  let qaWatchdog = null;\n\n  function normalize(text) {\n    return String(text || \"\").replace(/\\s+/g, \" \").trim();\n  }\n\n  function findForm() {\n    return document.getElementById(\"tool-form\") || document.querySelector(\"form\");\n  }\n\n  function findResult() {\n    return (\n      document.getElementById(\"tool-result\") ||\n      document.querySelector(\"[data-result]\") ||\n      document.querySelector(\".tool-result, .result-card, .result, .results, .output, .preview, .diagnostic, .analysis\")\n    );\n  }\n\n  function primaryAction(form) {\n    if (!form) return null;\n    return (\n      document.getElementById(\"tool-submit\") ||\n      form.querySelector(\"#tool-submit\") ||\n      form.querySelector(\"[data-primary-action]\") ||\n      form.querySelector(\"button[type=submit]\") ||\n      form.querySelector(\"button\") ||\n      form.querySelector(\"input[type=submit]\")\n    );\n  }\n\n  function resultSignature(node) {\n    if (!node) return \"\";\n    const text = normalize(node.textContent);\n    const html = normalize(node.innerHTML).slice(0, 600);\n    return `${text}||${html}`;\n  }\n\n  function resultHeadline(node) {\n    if (!node) return \"\";\n    const heading = node.querySelector(\"h1, h2, h3, strong, b\");\n    return normalize(heading ? heading.textContent : \"\");\n  }\n\n  function sampleText(field) {\n    const key = `${field.id || \"\"} ${field.name || \"\"} ${field.placeholder || \"\"}`.toLowerCase();\n    if (/email/.test(key)) return \"bonjour@example.com\";\n    if (/url|site|website|lien/.test(key)) return \"https://example.com/offre-solaire\";\n    if (/phone|tel|mobile/.test(key)) return \"0612345678\";\n    if (/ville|city|localisation|location|region|departement|postal/.test(key)) return \"Paris\";\n    if (/orientation/.test(key)) return \"sud\";\n    if (/keyword|theme|topic|sujet|subject/.test(key)) return \"energie solaire domestique\";\n    if (/titre|title/.test(key)) return \"Simulateur solaire maison\";\n    if (/nom|name|project/.test(key)) return \"Projet Horizon\";\n    if (/description|notes|content|message/.test(key)) return \"Maison individuelle exposee sud avec toiture exploitable.\";\n    return field.placeholder || \"France\";\n  }\n\n  function sampleNumber(field) {\n    const key = `${field.id || \"\"} ${field.name || \"\"}`.toLowerCase();\n    if (/inclinaison|angle|slope/.test(key)) return \"30\";\n    if (/surface|size|m2|sqm/.test(key)) return \"28\";\n    if (/annee|year/.test(key)) return \"2024\";\n    if (/prix|price|budget|cost|amount|montant/.test(key)) return \"12000\";\n    const min = Number(field.min || \"\");\n    const max = Number(field.max || \"\");\n    if (Number.isFinite(min) && Number.isFinite(max) && max >= min) {\n      return String(Math.min(max, Math.max(min, min + Math.round((max - min) * 0.35))));\n    }\n    if (Number.isFinite(min)) return String(Math.max(min, 12));\n    if (Number.isFinite(max)) return String(Math.min(max, 12));\n    return field.value || \"12\";\n  }\n\n  function applySample(field) {\n    const tag = (field.tagName || \"\").toLowerCase();\n    const type = (field.type || \"\").toLowerCase();\n    if (field.disabled) return;\n    if (type === \"hidden\" || type === \"submit\" || type === \"button\" || type === \"reset\" || type === \"image\" || type === \"file\") {\n      return;\n    }\n    const currentValue = normalize(field.value);\n    if (tag === \"select\") {\n      if (currentValue) return;\n      const option = Array.from(field.options || []).find((item) => item.value && !item.disabled) || field.options[0];\n      if (option) field.value = option.value;\n      return;\n    }\n    if (type === \"checkbox\") {\n      if (field.checked) return;\n      field.checked = true;\n      return;\n    }\n    if (type === \"radio\") {\n      if (field.checked) return;\n      field.checked = true;\n      return;\n    }\n    if (type === \"date\") {\n      if (currentValue) return;\n      field.value = \"2026-03-01\";\n      return;\n    }\n    if (type === \"email\") {\n      if (currentValue) return;\n      field.value = \"bonjour@example.com\";\n      return;\n    }\n    if (type === \"url\") {\n      if (currentValue) return;\n      field.value = \"https://example.com/offre-solaire\";\n      return;\n    }\n    if (type === \"tel\") {\n      if (currentValue) return;\n      field.value = \"0612345678\";\n      return;\n    }\n    if (type === \"color\") {\n      if (currentValue) return;\n      field.value = \"#2f855a\";\n      return;\n    }\n    if (type === \"number\" || type === \"range\") {\n      if (currentValue) return;\n      field.value = sampleNumber(field);\n      return;\n    }\n    if (currentValue) return;\n    field.value = sampleText(field);\n  }\n\n  function stamp(status, detail, headline, primary) {\n    if (qaFinished) return;\n    qaFinished = true;\n    if (qaWatchdog) {\n      window.clearTimeout(qaWatchdog);\n      qaWatchdog = null;\n    }\n    const node = marker();\n    node.dataset.status = status;\n    node.dataset.mode = \"native-form\";\n    node.dataset.detail = detail || \"\";\n    node.dataset.headline = headline || \"\";\n    node.dataset.primary = primary || \"\";\n    node.dataset.viewport = window.innerWidth <= 640 ? \"mobile\" : \"desktop\";\n    window.setTimeout(function () {\n      try {\n        window.stop();\n      } catch (_error) {}\n    }, 0);\n  }\n\n  function installModalGuards() {\n    const noop = function () {};\n    const approve = function () { return true; };\n    const empty = function () { return \"\"; };\n    try { window.alert = noop; } catch (_error) {}\n    try { window.confirm = approve; } catch (_error) {}\n    try { window.prompt = empty; } catch (_error) {}\n  }\n\n  function triggerAction(form, action) {\n    try {\n      if (typeof form.requestSubmit === \"function\") {\n        form.requestSubmit(action || undefined);\n        return;\n      }\n    } catch (_error) {}\n    if (action && typeof action.click === \"function\") {\n      action.click();\n      return;\n    }\n    form.dispatchEvent(new Event(\"submit\", { bubbles: true, cancelable: true }));\n  }\n\n  function inspectResult(before, attemptsLeft) {\n    const result = findResult();\n    if (!result) {\n      stamp(\"fail\", \"Result area was not found.\", \"\");\n      return;\n    }\n    const after = resultSignature(result);\n    const text = normalize(result.textContent);\n    if (after && after !== before && text.length >= 24) {\n      const primary = result.querySelector(\"a[href], button[data-href], [data-primary-url]\") || document.querySelector(\"#tool-result a[href]\");\n      stamp(\"pass\", \"Native form submission updated the result area.\", resultHeadline(result), primary ? (primary.getAttribute(\"href\") || primary.getAttribute(\"data-primary-url\") || \"\") : \"\");\n      return;\n    }\n    if (attemptsLeft > 0) {\n      window.setTimeout(function () {\n        inspectResult(before, attemptsLeft - 1);\n      }, 250);\n      return;\n    }\n    stamp(\"fail\", \"Result area did not render usable output.\", resultHeadline(result));\n  }\n\n  function runSmoke() {\n    const params = new URLSearchParams(window.location.search);\n    if (params.get(\"__qa\") !== \"functional\") return;\n    qaWatchdog = window.setTimeout(function () {\n      stamp(\"fail\", \"QA smoke timed out before the page reported a usable result.\", \"\");\n    }, 7000);\n    const form = findForm();\n    if (!form) {\n      stamp(\"fail\", \"Primary tool form was not found.\", \"\");\n      return;\n    }\n    const result = findResult();\n    const before = resultSignature(result);\n    installModalGuards();\n    try {\n      form.querySelectorAll(\"input, select, textarea\").forEach(applySample);\n    } catch (error) {\n      stamp(\"fail\", error && error.message ? `QA smoke sample failed: ${error.message}` : \"QA smoke sample failed before submit.\", \"\");\n      return;\n    }\n    const action = primaryAction(form);\n    try {\n      triggerAction(form, action);\n    } catch (error) {\n      stamp(\"fail\", error && error.message ? `QA smoke submit failed: ${error.message}` : \"QA smoke submit failed.\", \"\");\n      return;\n    }\n    inspectResult(before, 10);\n  }\n\n  window.addEventListener(\"error\", function (event) {\n    const message = event && event.message ? event.message : \"JavaScript runtime error during QA smoke.\";\n    stamp(\"fail\", `QA smoke JS error: ${message}`, \"\");\n  }, { once: true });\n\n  window.addEventListener(\"unhandledrejection\", function (event) {\n    const reason = event && event.reason;\n    const detail = typeof reason === \"string\"\n      ? reason\n      : reason && reason.message\n        ? reason.message\n        : \"Unhandled promise rejection during QA smoke.\";\n    stamp(\"fail\", `QA smoke rejection: ${detail}`, \"\");\n  }, { once: true });\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", function () {\n      window.setTimeout(runSmoke, 60);\n    }, { once: true });\n  } else {\n    window.setTimeout(runSmoke, 60);\n  }\n})();\n</script>\n</body>\n</html>",
